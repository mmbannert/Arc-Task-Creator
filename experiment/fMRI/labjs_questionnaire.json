      "id": "1",
      "type": "lab.html.Form",
      "content": "<form>\n  <section class=\"survey-section\">\n    <h2>Part A — General Strategy</h2>\n\n    <div class=\"question\">\n      <label for=\"A1\">\n        <strong>\n          Did you use a specific strategy to work out the rule shown in a pair of images?\n        </strong>\n      </label>\n\n      <textarea\n        class=\"text-answer\"\n        id=\"A1\"\n        name=\"A1\"\n        rows=\"5\"\n        required\n      ></textarea>\n    </div>\n\n    <div class=\"question\">\n      <label for=\"A2\">\n        <strong>\n          Did your strategy differ between the two kinds of blocks?\n        </strong>\n\n        <span class=\"question-note\">\n          Comparing to the previous pair vs. the memorized first pair.\n        </span>\n      </label>\n\n      <textarea\n        class=\"text-answer\"\n        id=\"A2\"\n        name=\"A2\"\n        rows=\"5\"\n        required\n      ></textarea>\n    </div>\n\n    <div class=\"question\">\n      <label for=\"A3\">\n        <strong>\n          Which of these two kinds of blocks felt easier, and why?\n        </strong>\n      </label>\n\n      <textarea\n        class=\"text-answer\"\n        id=\"A3\"\n        name=\"A3\"\n        rows=\"5\"\n        required\n      ></textarea>\n    </div>\n\n    <div class=\"form-actions\">\n      <button type=\"submit\">Next</button>\n    </div>\n  </section>\n</form>",
